# NUNCA coloque esta chave no index.html.
ATENAS_API_KEY=COLE_SUA_NOVA_API_KEY_AQUI
# A documentação atual usa este host como base da API.
ATENAS_BASE_URL=https://nexuspag.com
# URL pública do seu servidor, sem barra no final.
PUBLIC_BASE_URL=https://SEU-DOMINIO-OU-SERVIDOR
# Opcional, mas recomendado para validar webhooks.
WEBHOOK_SECRET=COLE_SEU_WEBHOOK_SECRET_AQUI
PIX_EXPIRATION=1800
PORT=3000
